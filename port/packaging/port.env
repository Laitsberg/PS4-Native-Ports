# Port profile read by the packaging scripts and the CI: one file per port, same keys everywhere.
PORT_NAME="PS4 Native Ports"        # executable, window and menu entry name
PORT_SLUG="ps4-native-ports"        # package prefix: <slug>-linux-x86_64.tar.gz, <slug>-windows-x86_64.zip
PORT_LAUNCHER="infamous_launcher_qt.py"       # port/launcher/<file>: the default launcher (Qt Quick), frozen with PyInstaller
PORT_LAUNCHER_CLASSIC="infamous_launcher.py"  # port/launcher/<file>: the Tk launcher, shipped as "$PORT_NAME (classic)"
PORT_QT_PACKAGE="PySide6-Essentials==6.12.0"  # pinned for the package (launcher/qt/requirements.txt says >=6.7)
PORT_ICON="infamous"                # port/launcher/<icon>.png and .ico (original art, never a game's; built from
                                    # packaging/icon/ps4-native-ports-icon-1024.png by windows/make_icon.py)
PORT_TITLE_ID="CUSA00223"
